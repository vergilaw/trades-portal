NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
ENABLE_DEMO_DATA_IMPORT=false

# Canonical public origin. Use HTTPS for the SePay webhook in production.
APP_URL=http://localhost:3000
# Server only: Supabase secret key (or legacy service_role key).
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# Server only: base64-encoded random 32-byte key; preserve it across deployments.
SEPAY_ENCRYPTION_KEY=replace-with-generated-base64-key
